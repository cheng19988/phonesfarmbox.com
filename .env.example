# Neon PostgreSQL (required). Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Create at https://console.neon.tech — do not commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth sessions (required in production)
JWT_SECRET="long-random-string-here"

# Admin login (seed + ensureAdminUser on login)
ADMIN_EMAIL="admin@phonesfarmbox.com"
ADMIN_PASSWORD="change-me-before-production"

# --- Inquiry notifications (configure at least one) ---

# Telegram: create bot via @BotFather, get chat id via @userinfobot or group id
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email via Resend (https://resend.com) — optional alternative to Telegram
RESEND_API_KEY=""
CONTACT_NOTIFY_EMAIL="qiuxui646@gmail.com"
CONTACT_FROM_EMAIL="inquiry@phonesfarmbox.com"

# USDT payment auto-verify (optional — auto-confirm not implemented; manual confirmation only)
TRON_API_KEY=""
